# CyberShield AI — Environment Configuration Template
# Copy to .env and configure appropriate values for your environment.

# ==============================================================================
# Environment Profile: development | test | demo | production
# ==============================================================================
ENVIRONMENT=development
DEBUG=true

# ==============================================================================
# Database Configuration
# ==============================================================================
# In development: SQLite is permitted (default)
DATABASE_URL=sqlite:///./cybershield.db

# In production / cloud: PostgreSQL is strictly required (psycopg v3 driver)
# DATABASE_URL=postgresql+psycopg://username:password@hostname:5432/dbname?sslmode=require

# ==============================================================================
# Authentication & Security
# ==============================================================================
# Required in production: must be a strong, randomly-generated secret (minimum 32 characters)
# In development only, a fallback key is provided.
JWT_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET_FOR_PRODUCTION
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Production Invariant: ALLOW_DEMO_LOGIN must be false in production
ALLOW_DEMO_LOGIN=true

# ==============================================================================
# CORS Configuration
# ==============================================================================
# Comma-separated list of exact allowed origin URLs (no wildcards permitted in production)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000

# ==============================================================================
# Demo Seeding Controls
# ==============================================================================
# In production and test: strictly prohibited (must be false)
# In development: set to true to seed initial demo dataset on startup
AUTO_SEED_DEMO_DATA=false

# ==============================================================================
# Frontend Client Variables (Vite)
# ==============================================================================
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_WS_URL=ws://localhost:8000/ws/alerts
