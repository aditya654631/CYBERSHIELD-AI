# Backend
# Local SQLite
DATABASE_URL=sqlite:///./cybershield.db

# Production PostgreSQL example:
# DATABASE_URL=postgresql+psycopg://USERNAME:PASSWORD@HOST:5432/cybershield

ML_MODEL_DIR=ml/models
JWT_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET

# CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# For production Render deployment, add your deployed frontend URL:
# CORS_ORIGINS=https://your-frontend.onrender.com,http://localhost:5173

# Frontend
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_WS_URL=ws://localhost:8000/ws/alerts

