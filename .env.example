# CyberShield AI Configuration
ENVIRONMENT=development
DEBUG=True
APP_NAME="CyberShield AI"
SECRET_KEY="sih-cybershield-ai-super-secure-production-jwt-key-2026"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Database Configuration (Defaults to SQLite for seamless local runs, can switch to PostgreSQL)
DATABASE_URL="sqlite:///./backend/cybershield.db"
# Example PostgreSQL URL:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cybershield"

# ML Model Configuration
ML_MODEL_DIR="./ml/artifacts"
USE_ML_FALLBACK=True

# API Ports
BACKEND_HOST="0.0.0.0"
BACKEND_PORT=8000
VITE_API_URL="http://localhost:8000/api/v1"

# Google Maps API Configuration (Optional: defaults to Leaflet/OpenStreetMap fallback if not set)
VITE_GOOGLE_MAPS_API_KEY=""
