{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CyberShield_Prediction_Hash_Contract",
  "description": "Canonical payload specification and SHA-256 hashing format for anchoring production ML predictions to Hyperledger Fabric.",
  "type": "object",
  "required": [
    "canonical_format_version",
    "required_fields",
    "normalization_rules",
    "hash_algorithm",
    "verification_states"
  ],
  "properties": {
    "canonical_format_version": {
      "type": "string",
      "const": "v1.0"
    },
    "hash_algorithm": {
      "type": "string",
      "const": "SHA-256"
    },
    "required_fields": {
      "type": "array",
      "items": { "type": "string" },
      "default": [
        "prediction_id",
        "complaint_number",
        "prediction_mode",
        "location_model_version",
        "time_model_version",
        "ordered_cluster_ids",
        "ordered_calibrated_scores",
        "predicted_window_hours",
        "created_at"
      ]
    },
    "normalization_rules": {
      "type": "object",
      "properties": {
        "key_ordering": { "type": "string", "const": "lexicographical (ASCII ascending)" },
        "string_encoding": { "type": "string", "const": "UTF-8" },
        "numeric_precision": { "type": "string", "const": "calibrated_scores formatted to exactly 6 decimal places (e.g. 0.351200)" },
        "timestamp_format": { "type": "string", "const": "ISO 8601 UTC with Z suffix (YYYY-MM-DDTHH:MM:SSZ)" },
        "whitespace": { "type": "string", "const": "Strict JSON minification without spaces after delimiters (, and :)" }
      }
    },
    "verification_states": {
      "type": "array",
      "items": { "type": "string" },
      "enum": [
        "VERIFIED",
        "MISMATCH",
        "NOT_ANCHORED",
        "BLOCKCHAIN_UNAVAILABLE"
      ]
    }
  },
  "example_canonical_payload": {
    "complaint_number": "CMP-2026-DEL-0091",
    "created_at": "2026-09-13T14:45:00Z",
    "location_model_version": "cashout-location-xgb-v4",
    "ordered_calibrated_scores": [0.351200, 0.284500, 0.198300],
    "ordered_cluster_ids": [12, 4, 27],
    "predicted_window_hours": 3.250000,
    "prediction_id": 84,
    "prediction_mode": "trained_ml",
    "time_model_version": "cashout-time-xgb-v3"
  }
}
