# ==============================================================================
# CyberShield AI — Cloud Fabric Gateway Reverse Proxy (Caddyfile)
# Automated TLS Termination, Request Body Sizing & Header Forwarding
# ==============================================================================

# Change {$DOMAIN} to your VPS public domain/subdomain, e.g. fabric-gateway.example.com
# For local evaluation or IP testing, replace with :80 or :443
{$DOMAIN:localhost} {
    # Request body size limitation for payload protection
    request_body {
        max_size 10MB
    }

    # Security headers
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
        -Server
    }

    # Reverse proxy to internal containerized Fabric Gateway service
    reverse_proxy gateway.cybershield.net:4000 {
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}

        transport http {
            keepalive 30s
            response_header_timeout 60s
        }
    }

    # Optional logging
    log {
        output stdout
        format json
    }
}
