# ==============================================================================
# CyberShield AI — Cloud Fabric Consortium Environment Configuration Template
# COPY TO .env BEFORE STARTING THE NETWORK
# DO NOT COMMIT REAL PRODUCTION SECRETS TO GIT
# ==============================================================================

# VPS Domain / Subdomain for Automated HTTPS (e.g. fabric.yourdomain.com)
DOMAIN=fabric.cybershield.net

# Service Authentication Token
# Generate a strong 64-char token (e.g., openssl rand -hex 32)
# Must match FABRIC_GATEWAY_TOKEN in Railway FastAPI backend
GATEWAY_AUTH_TOKEN=generate-a-secure-64-character-hex-token-here

# Fabric Configuration
FABRIC_VERSION=2.5
FABRIC_NETWORK_DIR=/opt/cybershield/blockchain/network
GATEWAY_PORT=4000

# Channel and Chaincodes
FABRIC_CHANNEL=cyber-intelligence
FABRIC_GEO_CHAINCODE=geo-intelligence
FABRIC_AUDIT_CHAINCODE=prediction-audit
